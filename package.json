{
  "name": "widgetwall",
  "version": "4.2.0",
  "description": "ウィジェットを自由に配置できる、おしゃれなライブ壁紙アプリ",
  "main": "src/main/main.js",
  "author": "PoohS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "genicon": "node scripts/genicon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.antigravity.widgetwall",
    "productName": "WidgetWall",
    "compression": "maximum",
    "publish": [
      {
        "provider": "github",
        "owner": "Orahu01",
        "repo": "wallpaper"
      }
    ],
    "electronLanguages": [
      "ja",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!src/renderer/settings/preview.html",
      "!assets/screenshot.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "WidgetWall"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.5"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
